# Each of these groups of CODEOWNERS have approval and merge authority over
# the noted directories.
#
# If you want to add, modify, or delete files in any of these directories,
# open a pull request. Then add the appropriate group name (without the `@`)
# to the list of "Reviewers."
#
# Order is important; the last matching pattern takes precedence.
# For example, when someone opens a pull request that only modifies files
# in the content/nginx-one directory, you should assign @nginxinc/one-docs-approvers
# as a reviewer.
#
# Lines starting with '#' are comments.
# Each line is a file pattern followed by one or more owners.

# DocOps Writers
*                           @nginx/nginx-docs

# DocOps Engineers
.github/                    @nginx/docs-engineering

# F5 DoS for NGINX
content/nap-dos/            @nginx/dos-docs-approvers
content/includes/dos/       @nginx/dos-docs-approvers

# F5 WAF for NGINX
content/waf/                @nginx/nap-dev
content/includes/waf/       @nginx/nap-dev @nginx/nim-docs-approvers

# NGINXaaS (AWS + Google Cloud + shared overview)
content/nginxaas/           @nginx/nginxaas-docs-approvers
content/includes/nginxaas/  @nginx/nginxaas-docs-approvers

# NGINXaaS for Azure
content/nginxaas-azure/           @nginx/nginxaas-docs-approvers
content/includes/nginxaas-azure/  @nginx/nginxaas-docs-approvers

# F5 Application Delivery Service (F5 ADS)
content/f5ads/           @nginx/nginxaas-docs-approvers
content/includes/f5ads/  @nginx/nginxaas-docs-approvers

# NGINX Gateway Fabric
content/ngf/                @nginx/nginx-gateway-fabric
content/includes/ngf/       @nginx/nginx-gateway-fabric

# NGINX Ingress Controller
content/nic/                    @nginx/kic
